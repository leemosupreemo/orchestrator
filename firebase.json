{
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "firestore": { "rules": "firestore.rules" },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Swift Orchestrator Web",
        "supportEmail": "enmeskin@gmail.com"
      }
    }
  },
  "emulators": {
    "firestore": { "port": 8089 },
    "ui": { "enabled": false }
  }
}
